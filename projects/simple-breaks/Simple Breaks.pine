//@version=6
indicator("Simple Breaks — Selectable Timeframes", shorttitle="MTF BREAK", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=50, dynamic_requests=true)

// BREAK swings require two bullish then two bearish candles for a HIGH, and
// two bearish then two bullish candles for a LOW. Dojis inherit direction.
GROUP_GENERAL = "General Settings"
GROUP_VISIBLE_TF = "Visible Timeframes"

Hide_Breaks = input.bool(false, "Hide all breaks", group=GROUP_GENERAL)
Show_Swing_Labels = input.bool(false, "Show swing HIGH / LOW labels", group=GROUP_GENERAL)
Bull_Break_Color = input.color(color.green, "Bullish break color", group=GROUP_GENERAL)
Bear_Break_Color = input.color(color.red, "Bearish break color", group=GROUP_GENERAL)
Max_Visible_Breaks = input.int(2, "Maximum visible breaks", minval=1, maxval=166, group=GROUP_GENERAL)
Max_Visible_NC_S = input.int(2, "Maximum visible NC + S marks", minval=0, maxval=166, group=GROUP_GENERAL)
Max_Swing_Age_Bars = input.int(96, "Maximum bars from swing to first touch", minval=1, maxval=1000, group=GROUP_GENERAL, tooltip="A swing expires if it is not first-tested within this many bars of its own timeframe. At 96 bars, a 15-minute swing expires after 24 hours.")
Doji_Body_Range_Percent = input.float(10.0, "Doji body threshold (% of range)", minval=0.0, maxval=50.0, step=0.5, group=GROUP_GENERAL, tooltip="Candles whose body is at or below this percentage of the full high-low range are ignored for touch tests and inherit the prior candle direction for swing counting.")
Overlap_Tolerance_Ticks = input.int(3, "Higher-timeframe overlap tolerance (ticks)", minval=0, maxval=100, group=GROUP_GENERAL, tooltip="A lower-timeframe break is treated as the same swing when its pivot time is within one higher-timeframe bar and its level is within this many ticks.")
Break_Line_Style = input.string("Solid", "Break line style", options=["Solid", "Dashed", "Dotted"], group=GROUP_GENERAL)
Break_Line_Width = input.int(1, "Break line width", minval=1, maxval=5, group=GROUP_GENERAL)
Protected_Line_Style = input.string("Solid", "Protected structure line style", options=["Solid", "Dashed", "Dotted"], group=GROUP_GENERAL)
Protected_Line_Color = input.color(color.rgb(156, 156, 156), "Protected structure color", group=GROUP_GENERAL)
var array<line> Break_Lines = array.new<line>()
var array<label> Break_Labels = array.new<label>()
var array<int> Break_Directions = array.new<int>()
var array<float> Break_Levels = array.new<float>()
var array<int> Break_Event_Times = array.new<int>()
var array<int> Break_Timeframe_Seconds = array.new<int>()
var array<label> Break_Protected_Labels = array.new<label>()
var array<line> Break_Protected_Lines = array.new<line>()
var array<line> NC_S_Lines = array.new<line>()
var array<label> NC_S_Labels = array.new<label>()
var array<int> Chart_Bar_Times = array.new<int>()
var array<float> Chart_Bar_Highs = array.new<float>()
var array<float> Chart_Bar_Lows = array.new<float>()
var array<string> Higher_Break_Keys = array.new<string>()
var array<int> Higher_Break_Directions = array.new<int>()
var array<float> Higher_Break_Levels = array.new<float>()
var array<int> Higher_Break_Times = array.new<int>()
var array<int> Higher_Break_Durations = array.new<int>()
var array<int> Higher_Break_Ranks = array.new<int>()
MAX_STORED_SWINGS_PER_SIDE = 16

array.push(Chart_Bar_Times, time)
array.push(Chart_Bar_Highs, high)
array.push(Chart_Bar_Lows, low)
if array.size(Chart_Bar_Times) > Max_Swing_Age_Bars + 10
    array.shift(Chart_Bar_Times)
    array.shift(Chart_Bar_Highs)
    array.shift(Chart_Bar_Lows)

Show_Min1 = input.bool(false, "1 minute", group=GROUP_VISIBLE_TF)
Show_Min2 = input.bool(false, "2 minutes", group=GROUP_VISIBLE_TF)
Show_Min3 = input.bool(false, "3 minutes", group=GROUP_VISIBLE_TF)
Show_Min5 = input.bool(false, "5 minutes", group=GROUP_VISIBLE_TF)
Show_Min10 = input.bool(false, "10 minutes", group=GROUP_VISIBLE_TF)
Show_Min15 = input.bool(true, "15 minutes", group=GROUP_VISIBLE_TF)
Show_Min30 = input.bool(false, "30 minutes", group=GROUP_VISIBLE_TF)
Show_Min45 = input.bool(false, "45 minutes", group=GROUP_VISIBLE_TF)
Show_Hr1 = input.bool(true, "1 hour", group=GROUP_VISIBLE_TF)
Show_Hr2 = input.bool(false, "2 hours", group=GROUP_VISIBLE_TF)
Show_Hr3 = input.bool(false, "3 hours", group=GROUP_VISIBLE_TF)
Show_Hr4 = input.bool(true, "4 hours", group=GROUP_VISIBLE_TF)
Show_Day1 = input.bool(true, "1 day", group=GROUP_VISIBLE_TF)
Show_Week1 = input.bool(true, "1 week", group=GROUP_VISIBLE_TF)
Show_Month1 = input.bool(false, "1 month", group=GROUP_VISIBLE_TF)
Show_Month3 = input.bool(false, "3 months", group=GROUP_VISIBLE_TF)
Show_Month6 = input.bool(false, "6 months", group=GROUP_VISIBLE_TF)
Show_Month12 = input.bool(false, "12 months", group=GROUP_VISIBLE_TF)

f_line_style(string style) =>
    switch style
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_range_extreme(int startTime, int endTime, bool findHigh) =>
    float extremePrice = na
    int extremeTime = na
    if not na(startTime) and not na(endTime) and array.size(Chart_Bar_Times) > 0
        for i = array.size(Chart_Bar_Times) - 1 to 0
            int barTime = array.get(Chart_Bar_Times, i)
            if barTime >= startTime and barTime <= endTime
                float value = findHigh ? array.get(Chart_Bar_Highs, i) : array.get(Chart_Bar_Lows, i)
                bool moreExtreme = na(extremePrice) or (findHigh ? value > extremePrice : value < extremePrice)
                if moreExtreme
                    extremePrice := value
                    extremeTime := barTime
    [extremePrice, extremeTime]

f_remove_aligned_nc(float protectedPrice, int protectedStart, int protectedEnd, array<line> ncLines, array<label> ncLabels) =>
    if not na(protectedPrice) and array.size(ncLines) > 0
        for i = array.size(ncLines) - 1 to 0
            line ncLine = array.get(ncLines, i)
            bool samePrice = math.abs(line.get_y1(ncLine) - protectedPrice) <= syminfo.mintick * Overlap_Tolerance_Ticks
            bool timeOverlaps = line.get_x1(ncLine) <= protectedEnd and line.get_x2(ncLine) >= protectedStart
            if samePrice and timeOverlaps
                line.delete(ncLine)
                label.delete(array.get(ncLabels, i))
                array.remove(ncLines, i)
                array.remove(ncLabels, i)

f_is_protected_level(float level, int eventStart, int eventEnd, array<line> protectedLines) =>
    bool matches = false
    if not na(level) and array.size(protectedLines) > 0
        for i = 0 to array.size(protectedLines) - 1
            line protectedLine = array.get(protectedLines, i)
            bool samePrice = math.abs(line.get_y1(protectedLine) - level) <= syminfo.mintick * Overlap_Tolerance_Ticks
            bool timeOverlaps = line.get_x1(protectedLine) <= eventEnd and line.get_x2(protectedLine) >= eventStart
            if samePrice and timeOverlaps
                matches := true
    matches

type TFEvent
    bool newHigh
    float highPrice
    int highTime
    bool newLow
    float lowPrice
    int lowTime
    bool bullBreak
    bool bearBreak
    int bullTime
    float bullLevel
    int bearTime
    float bearLevel
    int bullStartTime
    int bearStartTime
    bool ncSweep

f_is_duplicate(int direction, float level, int pivotTime, int timeframeSeconds, array<int> higherDirections, array<float> higherLevels, array<int> higherTimes, array<int> higherDurations, array<int> higherRanks) =>
    bool duplicate = false
    if array.size(higherDirections) > 0
        for i = 0 to array.size(higherDirections) - 1
            bool sameDirection = array.get(higherDirections, i) == direction
            bool samePrice = math.abs(array.get(higherLevels, i) - level) <= syminfo.mintick * Overlap_Tolerance_Ticks
            bool closeInTime = math.abs(array.get(higherTimes, i) - pivotTime) <= array.get(higherDurations, i)
            bool higherTimeframe = array.get(higherRanks, i) > timeframeSeconds
            if sameDirection and samePrice and closeInTime and higherTimeframe
                duplicate := true
    duplicate

f_register_higher_break(bool triggered, int direction, float level, int eventTime, int pivotTime, int timeframeSeconds, array<string> keys, array<int> higherDirections, array<float> higherLevels, array<int> higherTimes, array<int> higherDurations, array<int> higherRanks, array<line> breakLines, array<label> breakLabels, array<label> protectedLabels, array<line> protectedLines, array<int> breakDirections, array<float> breakLevels, array<int> breakTimes, array<int> breakRanks) =>
    if triggered and not na(level) and not na(eventTime) and timeframeSeconds > timeframe.in_seconds(timeframe.period)
        string key = str.tostring(timeframeSeconds) + "_" + str.tostring(direction) + "_" + str.tostring(eventTime)
        if not array.includes(keys, key)
            array.push(keys, key)
            array.push(higherDirections, direction)
            array.push(higherLevels, level)
            array.push(higherTimes, pivotTime)
            array.push(higherDurations, timeframeSeconds * 1000)
            array.push(higherRanks, timeframeSeconds)
            if array.size(keys) > 500
                array.shift(keys)
                array.shift(higherDirections)
                array.shift(higherLevels)
                array.shift(higherTimes)
                array.shift(higherDurations)
                array.shift(higherRanks)
            if array.size(breakLines) > 0
                for i = array.size(breakLines) - 1 to 0
                    bool sameDirection = array.get(breakDirections, i) == direction
                    bool samePrice = math.abs(array.get(breakLevels, i) - level) <= syminfo.mintick * Overlap_Tolerance_Ticks
                    bool closeInTime = math.abs(array.get(breakTimes, i) - pivotTime) <= timeframeSeconds * 1000
                    bool lowerTimeframe = array.get(breakRanks, i) < timeframeSeconds
                    if sameDirection and samePrice and closeInTime and lowerTimeframe
                        line.delete(array.get(breakLines, i))
                        label.delete(array.get(breakLabels, i))
                        label protectedLabel = array.get(protectedLabels, i)
                        if not na(protectedLabel)
                            label.delete(protectedLabel)
                        line protectedLine = array.get(protectedLines, i)
                        if not na(protectedLine)
                            line.delete(protectedLine)
                        array.remove(breakLines, i)
                        array.remove(breakLabels, i)
                        array.remove(protectedLabels, i)
                        array.remove(protectedLines, i)
                        array.remove(breakDirections, i)
                        array.remove(breakLevels, i)
                        array.remove(breakTimes, i)
                        array.remove(breakRanks, i)

f_track_timeframe(TFEvent event, bool selected, int timeframeSeconds) =>
    f_register_higher_break(selected and event.bullBreak, 1, event.bullLevel, event.bullTime, event.bullStartTime, timeframeSeconds, Higher_Break_Keys, Higher_Break_Directions, Higher_Break_Levels, Higher_Break_Times, Higher_Break_Durations, Higher_Break_Ranks, Break_Lines, Break_Labels, Break_Protected_Labels, Break_Protected_Lines, Break_Directions, Break_Levels, Break_Event_Times, Break_Timeframe_Seconds)
    f_register_higher_break(selected and event.bearBreak, -1, event.bearLevel, event.bearTime, event.bearStartTime, timeframeSeconds, Higher_Break_Keys, Higher_Break_Directions, Higher_Break_Levels, Higher_Break_Times, Higher_Break_Durations, Higher_Break_Ranks, Break_Lines, Break_Labels, Break_Protected_Labels, Break_Protected_Lines, Break_Directions, Break_Levels, Break_Event_Times, Break_Timeframe_Seconds)

f_tf_events() =>
    // Ignore small-bodied dojis in test logic and inherit the last real direction.
    var int previousDirection = 0
    float candleBody = math.abs(close - open)
    float candleRange = high - low
    bool isDoji = candleRange == 0.0 or candleBody <= candleRange * Doji_Body_Range_Percent / 100.0
    int candleDirection = isDoji ? previousDirection : close > open ? 1 : close < open ? -1 : previousDirection
    previousDirection := candleDirection

    // Each qualifying swing is stored independently. A new swing does not
    // overwrite an older swing that is still waiting for its first test.
    var int direction = 0
    var int runLength = 0
    var float runHigh = na
    var float runLow = na
    var int runHighTime = na
    var int runLowTime = na
    var int pendingDirection = 0
    var int pendingRunLength = 0
    var float pendingHigh = na
    var float pendingLow = na
    var int pendingHighTime = na
    var int pendingLowTime = na
    var float lastHigh = na
    var float lastLow = na
    var int lastHighTime = na
    var int lastLowTime = na
    var array<float> highLevels = array.new<float>()
    var array<int> highPivotTimes = array.new<int>()
    var array<int> highConfirmedTimes = array.new<int>()
    var array<bool> highFollowUps = array.new<bool>()
    var array<float> highTestOpens = array.new<float>()
    var array<int> highTestTimes = array.new<int>()
    var array<float> lowLevels = array.new<float>()
    var array<int> lowPivotTimes = array.new<int>()
    var array<int> lowConfirmedTimes = array.new<int>()
    var array<bool> lowFollowUps = array.new<bool>()
    var array<float> lowTestOpens = array.new<float>()
    var array<int> lowTestTimes = array.new<int>()
    // NC + S has a separate 1-2 / 2-1 reversal detector; BREAK uses 2-2.
    var array<float> ncHighLevels = array.new<float>()
    var array<int> ncHighPivotTimes = array.new<int>()
    var array<int> ncHighConfirmedTimes = array.new<int>()
    var array<bool> ncHighFollowUps = array.new<bool>()
    var array<float> ncHighTestOpens = array.new<float>()
    var array<int> ncHighTestTimes = array.new<int>()
    var array<float> ncLowLevels = array.new<float>()
    var array<int> ncLowPivotTimes = array.new<int>()
    var array<int> ncLowConfirmedTimes = array.new<int>()
    var array<bool> ncLowFollowUps = array.new<bool>()
    var array<float> ncLowTestOpens = array.new<float>()
    var array<int> ncLowTestTimes = array.new<int>()
    var int ncRunDirection = 0
    var int ncRunLength = 0
    var float ncRunHigh = na
    var float ncRunLow = na
    var int ncRunHighTime = na
    var int ncRunLowTime = na
    var int ncPriorDirection = 0
    var int ncPriorRunLength = 0
    var float ncPriorHigh = na
    var float ncPriorLow = na
    var int ncPriorHighTime = na
    var int ncPriorLowTime = na
    var bool ncPatternRecorded = false
    bool newHigh = false
    bool newLow = false
    bool bullBreak = false
    bool bearBreak = false
    bool ncSweep = false
    int bullBreakTime = na
    float bullBreakLevel = na
    int bearBreakTime = na
    float bearBreakLevel = na
    int ncSweepTime = na
    float ncSweepLevel = na
    int ncSweepStartTime = na
    int bullBreakStartTime = na
    int bearBreakStartTime = na

    // NC + S has its own reversal pattern: 1 bullish then 2 bearish, or
    // 2 bullish then 1 bearish for a HIGH; reverse the directions for a LOW.
    // Dojis inherit direction through candleDirection just like Break swings.
    if candleDirection != 0
        if ncRunDirection == 0
            ncRunDirection := candleDirection
            ncRunLength := 1
            ncRunHigh := high
            ncRunLow := low
            ncRunHighTime := time
            ncRunLowTime := time
        else if candleDirection == ncRunDirection
            ncRunLength += 1
            if high > ncRunHigh
                ncRunHigh := high
                ncRunHighTime := time
            if low < ncRunLow
                ncRunLow := low
                ncRunLowTime := time
        else
            ncPriorDirection := ncRunDirection
            ncPriorRunLength := ncRunLength
            ncPriorHigh := ncRunHigh
            ncPriorLow := ncRunLow
            ncPriorHighTime := ncRunHighTime
            ncPriorLowTime := ncRunLowTime
            ncRunDirection := candleDirection
            ncRunLength := 1
            ncRunHigh := high
            ncRunLow := low
            ncRunHighTime := time
            ncRunLowTime := time
            ncPatternRecorded := false

        bool ncHighPattern = ncRunDirection == -1 and ncPriorDirection == 1 and ((ncPriorRunLength >= 1 and ncRunLength >= 2) or (ncPriorRunLength >= 2 and ncRunLength >= 1))
        bool ncLowPattern = ncRunDirection == 1 and ncPriorDirection == -1 and ((ncPriorRunLength >= 1 and ncRunLength >= 2) or (ncPriorRunLength >= 2 and ncRunLength >= 1))
        if not ncPatternRecorded and ncHighPattern
            float candidateHigh = math.max(ncPriorHigh, ncRunHigh)
            int candidateHighTime = ncPriorHigh >= ncRunHigh ? ncPriorHighTime : ncRunHighTime
            array.push(ncHighLevels, candidateHigh)
            array.push(ncHighPivotTimes, candidateHighTime)
            array.push(ncHighConfirmedTimes, time_close)
            array.push(ncHighFollowUps, false)
            array.push(ncHighTestOpens, na)
            array.push(ncHighTestTimes, na)
            if array.size(ncHighLevels) > MAX_STORED_SWINGS_PER_SIDE
                array.shift(ncHighLevels)
                array.shift(ncHighPivotTimes)
                array.shift(ncHighConfirmedTimes)
                array.shift(ncHighFollowUps)
                array.shift(ncHighTestOpens)
                array.shift(ncHighTestTimes)
            ncPatternRecorded := true
        else if not ncPatternRecorded and ncLowPattern
            float candidateLow = math.min(ncPriorLow, ncRunLow)
            int candidateLowTime = ncPriorLow <= ncRunLow ? ncPriorLowTime : ncRunLowTime
            array.push(ncLowLevels, candidateLow)
            array.push(ncLowPivotTimes, candidateLowTime)
            array.push(ncLowConfirmedTimes, time_close)
            array.push(ncLowFollowUps, false)
            array.push(ncLowTestOpens, na)
            array.push(ncLowTestTimes, na)
            if array.size(ncLowLevels) > MAX_STORED_SWINGS_PER_SIDE
                array.shift(ncLowLevels)
                array.shift(ncLowPivotTimes)
                array.shift(ncLowConfirmedTimes)
                array.shift(ncLowFollowUps)
                array.shift(ncLowTestOpens)
                array.shift(ncLowTestTimes)
            ncPatternRecorded := true

    if candleDirection != 0
        if direction == 0
            direction := candleDirection
            runLength := 1
            runHigh := high
            runLow := low
            runHighTime := time
            runLowTime := time
        else if candleDirection == direction
            runLength += 1
            if high > runHigh
                runHigh := high
                runHighTime := time
            if low < runLow
                runLow := low
                runLowTime := time
        else
            if runLength >= 1
                pendingDirection := direction
                pendingRunLength := runLength
                pendingHigh := runHigh
                pendingLow := runLow
                pendingHighTime := runHighTime
                pendingLowTime := runLowTime
            else
                pendingDirection := 0
                pendingRunLength := 0
            direction := candleDirection
            runLength := 1
            runHigh := high
            runLow := low
            runHighTime := time
            runLowTime := time

        bool highPattern = pendingDirection == 1 and pendingRunLength >= 2 and runLength >= 2
        bool lowPattern = pendingDirection == -1 and pendingRunLength >= 2 and runLength >= 2
        if highPattern
            float structureHigh = math.max(pendingHigh, runHigh)
            int structureHighTime = pendingHigh >= runHigh ? pendingHighTime : runHighTime
            lastHigh := structureHigh
            lastHighTime := structureHighTime
            array.push(highLevels, structureHigh)
            array.push(highPivotTimes, structureHighTime)
            array.push(highConfirmedTimes, time_close)
            array.push(highFollowUps, false)
            array.push(highTestOpens, na)
            array.push(highTestTimes, na)
            if array.size(highLevels) > MAX_STORED_SWINGS_PER_SIDE
                array.shift(highLevels)
                array.shift(highPivotTimes)
                array.shift(highConfirmedTimes)
                array.shift(highFollowUps)
                array.shift(highTestOpens)
                array.shift(highTestTimes)
            newHigh := true
            pendingDirection := 0
            pendingRunLength := 0
        else if lowPattern
            float structureLow = math.min(pendingLow, runLow)
            int structureLowTime = pendingLow <= runLow ? pendingLowTime : runLowTime
            lastLow := structureLow
            lastLowTime := structureLowTime
            array.push(lowLevels, structureLow)
            array.push(lowPivotTimes, structureLowTime)
            array.push(lowConfirmedTimes, time_close)
            array.push(lowFollowUps, false)
            array.push(lowTestOpens, na)
            array.push(lowTestTimes, na)
            if array.size(lowLevels) > MAX_STORED_SWINGS_PER_SIDE
                array.shift(lowLevels)
                array.shift(lowPivotTimes)
                array.shift(lowConfirmedTimes)
                array.shift(lowFollowUps)
                array.shift(lowTestOpens)
                array.shift(lowTestTimes)
            newLow := true
            pendingDirection := 0
            pendingRunLength := 0

    // Process HIGH swing records newest-first. A wick touch is the first test.
    // If it misses, keep evaluating each same-direction candle until a body
    // confirms the break or a real opposite-direction candle ends the attempt.
    if array.size(highLevels) > 0
        for i = array.size(highLevels) - 1 to 0
            float level = array.get(highLevels, i)
            bool followUpPending = array.get(highFollowUps, i)
            bool removeLevel = false
            int confirmedAt = array.get(highConfirmedTimes, i)
            bool expired = not followUpPending and time - confirmedAt > timeframe.in_seconds() * 1000 * Max_Swing_Age_Bars
            if expired
                removeLevel := true
            else if followUpPending and time > array.get(highTestTimes, i)
                float firstOpen = array.get(highTestOpens, i)
                bool combinedBodyPasses = close >= 2.0 * level - firstOpen
                bool currentBodyPasses = close >= 2.0 * level - open
                if not isDoji and close > open
                    if combinedBodyPasses or currentBodyPasses
                        if not bullBreak
                            bullBreak := true
                            bullBreakTime := time_close
                            bullBreakLevel := level
                            bullBreakStartTime := array.get(highPivotTimes, i)
                        removeLevel := true
                else if not isDoji and close < open
                    removeLevel := true
            else if not followUpPending and not isDoji and time >= array.get(highConfirmedTimes, i) and high >= level
                if close >= 2.0 * level - open
                    if not bullBreak
                        bullBreak := true
                        bullBreakTime := time_close
                        bullBreakLevel := level
                        bullBreakStartTime := array.get(highPivotTimes, i)
                    removeLevel := true
                else
                    array.set(highFollowUps, i, true)
                    array.set(highTestOpens, i, open)
                    array.set(highTestTimes, i, time)
            if removeLevel
                array.remove(highLevels, i)
                array.remove(highPivotTimes, i)
                array.remove(highConfirmedTimes, i)
                array.remove(highFollowUps, i)
                array.remove(highTestOpens, i)
                array.remove(highTestTimes, i)

    // Process LOW swing records with the mirrored continuation rule.
    if array.size(lowLevels) > 0
        for i = array.size(lowLevels) - 1 to 0
            float level = array.get(lowLevels, i)
            bool followUpPending = array.get(lowFollowUps, i)
            bool removeLevel = false
            int confirmedAt = array.get(lowConfirmedTimes, i)
            bool expired = not followUpPending and time - confirmedAt > timeframe.in_seconds() * 1000 * Max_Swing_Age_Bars
            if expired
                removeLevel := true
            else if followUpPending and time > array.get(lowTestTimes, i)
                float firstOpen = array.get(lowTestOpens, i)
                bool combinedBodyPasses = close <= 2.0 * level - firstOpen
                bool currentBodyPasses = close <= 2.0 * level - open
                if not isDoji and close < open
                    if combinedBodyPasses or currentBodyPasses
                        if not bearBreak
                            bearBreak := true
                            bearBreakTime := time_close
                            bearBreakLevel := level
                            bearBreakStartTime := array.get(lowPivotTimes, i)
                        removeLevel := true
                else if not isDoji and close > open
                    removeLevel := true
            else if not followUpPending and not isDoji and time >= array.get(lowConfirmedTimes, i) and low <= level
                if close <= 2.0 * level - open
                    if not bearBreak
                        bearBreak := true
                        bearBreakTime := time_close
                        bearBreakLevel := level
                        bearBreakStartTime := array.get(lowPivotTimes, i)
                    removeLevel := true
                else
                    array.set(lowFollowUps, i, true)
                    array.set(lowTestOpens, i, open)
                    array.set(lowTestTimes, i, time)
            if removeLevel
                array.remove(lowLevels, i)
                array.remove(lowPivotTimes, i)
                array.remove(lowConfirmedTimes, i)
                array.remove(lowFollowUps, i)
                array.remove(lowTestOpens, i)
                array.remove(lowTestTimes, i)

    // Evaluate first tests and failed continuation sequences against the
    // separately-qualified NC + S swing candidates.
    if array.size(ncHighLevels) > 0
        for i = array.size(ncHighLevels) - 1 to 0
            float level = array.get(ncHighLevels, i)
            bool followUpPending = array.get(ncHighFollowUps, i)
            bool removeLevel = false
            int confirmedAt = array.get(ncHighConfirmedTimes, i)
            bool expired = not followUpPending and time - confirmedAt > timeframe.in_seconds() * 1000 * Max_Swing_Age_Bars
            if expired
                removeLevel := true
            else if followUpPending and time > array.get(ncHighTestTimes, i)
                float firstOpen = array.get(ncHighTestOpens, i)
                bool combinedBodyPasses = close >= 2.0 * level - firstOpen
                bool currentBodyPasses = close >= 2.0 * level - open
                if not isDoji and close > open
                    if combinedBodyPasses or currentBodyPasses
                        removeLevel := true
                else if not isDoji and close < open
                    if not ncSweep
                        ncSweep := true
                        ncSweepTime := time_close
                        ncSweepLevel := level
                        ncSweepStartTime := array.get(ncHighPivotTimes, i)
                    removeLevel := true
            else if not followUpPending and not isDoji and time >= confirmedAt and high >= level
                if close >= 2.0 * level - open
                    removeLevel := true
                else
                    array.set(ncHighFollowUps, i, true)
                    array.set(ncHighTestOpens, i, open)
                    array.set(ncHighTestTimes, i, time)
            if removeLevel
                array.remove(ncHighLevels, i)
                array.remove(ncHighPivotTimes, i)
                array.remove(ncHighConfirmedTimes, i)
                array.remove(ncHighFollowUps, i)
                array.remove(ncHighTestOpens, i)
                array.remove(ncHighTestTimes, i)

    if array.size(ncLowLevels) > 0
        for i = array.size(ncLowLevels) - 1 to 0
            float level = array.get(ncLowLevels, i)
            bool followUpPending = array.get(ncLowFollowUps, i)
            bool removeLevel = false
            int confirmedAt = array.get(ncLowConfirmedTimes, i)
            bool expired = not followUpPending and time - confirmedAt > timeframe.in_seconds() * 1000 * Max_Swing_Age_Bars
            if expired
                removeLevel := true
            else if followUpPending and time > array.get(ncLowTestTimes, i)
                float firstOpen = array.get(ncLowTestOpens, i)
                bool combinedBodyPasses = close <= 2.0 * level - firstOpen
                bool currentBodyPasses = close <= 2.0 * level - open
                if not isDoji and close < open
                    if combinedBodyPasses or currentBodyPasses
                        removeLevel := true
                else if not isDoji and close > open
                    if not ncSweep
                        ncSweep := true
                        ncSweepTime := time_close
                        ncSweepLevel := level
                        ncSweepStartTime := array.get(ncLowPivotTimes, i)
                    removeLevel := true
            else if not followUpPending and not isDoji and time >= confirmedAt and low <= level
                if close <= 2.0 * level - open
                    removeLevel := true
                else
                    array.set(ncLowFollowUps, i, true)
                    array.set(ncLowTestOpens, i, open)
                    array.set(ncLowTestTimes, i, time)
            if removeLevel
                array.remove(ncLowLevels, i)
                array.remove(ncLowPivotTimes, i)
                array.remove(ncLowConfirmedTimes, i)
                array.remove(ncLowFollowUps, i)
                array.remove(ncLowTestOpens, i)
                array.remove(ncLowTestTimes, i)

    // Return only the previous source-timeframe bar's values. The security
    // calls below use lookahead_on, so these are confirmed bars, not live bars.
    int breakCode = bullBreak[1] ? (bearBreak[1] ? 2 : 1) : bearBreak[1] ? -1 : ncSweep[1] ? 3 : 0
    int eventTime = breakCode == 3 ? ncSweepTime[1] : breakCode != 0 ? (bullBreak[1] ? bullBreakTime[1] : bearBreakTime[1]) : na
    float returnedBullLevel = breakCode == 3 ? ncSweepLevel[1] : bullBreakLevel[1]
    int returnedBullStart = breakCode == 3 ? ncSweepStartTime[1] : bullBreakStartTime[1]
    [breakCode, returnedBullLevel, breakCode == 3 ? na : bearBreakLevel[1], eventTime, returnedBullStart, breakCode == 3 ? na : bearBreakStartTime[1]]

f_request_events(string sourceTf, bool selected, int timeframeSeconds) =>
    if selected and timeframe.in_seconds(timeframe.period) <= timeframeSeconds
        request.security(syminfo.tickerid, sourceTf, f_tf_events(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, calc_bars_count=1000)
    else
        [0, na, na, na, na, na]

