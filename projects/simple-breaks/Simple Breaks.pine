f_draw(string tfName, string sourceTf, int tfSeconds, bool enabled, string style, int width, bool newHigh, float highPrice, int highTime, bool newLow, float lowPrice, int lowTime, bool bullBreak, bool bearBreak, bool ncSweep, int bullEventTime, float bullEventLevel, int bearEventTime, float bearEventLevel, int bullStartTime, int bearStartTime, array<line> breakLines, array<label> breakLabels, array<label> protectedLabels, array<int> breakDirections, array<float> breakLevels, array<int> breakTimes, array<int> breakRanks, array<int> higherDirections, array<float> higherLevels, array<int> higherTimes, array<int> higherDurations, array<int> higherRanks, array<line> ncLines, array<label> ncLabels, int maxVisibleBreaks, int maxVisibleNCS) =>
    bool sameTimeframe = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds(sourceTf)
    bool canDraw = enabled and sameTimeframe
    array<line> protectedLines = Break_Protected_Lines
    if canDraw and Show_Swing_Labels and newHigh
        label.new(highTime, highPrice, "HIGH " + tfName, xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_down, textcolor=Bear_Break_Color, size=size.small, force_overlay=true)
    if canDraw and Show_Swing_Labels and newLow
        label.new(lowTime, lowPrice, "LOW " + tfName, xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_up, textcolor=Bull_Break_Color, size=size.small, force_overlay=true)
    bool duplicateBull = bullBreak and f_is_duplicate(1, bullEventLevel, bullStartTime, tfSeconds, higherDirections, higherLevels, higherTimes, higherDurations, higherRanks)
    bool duplicateBear = bearBreak and f_is_duplicate(-1, bearEventLevel, bearStartTime, tfSeconds, higherDirections, higherLevels, higherTimes, higherDurations, higherRanks)
    if canDraw and not Hide_Breaks and bullBreak and not duplicateBull
        [protectedLowPrice, protectedLowTime] = f_range_extreme(bullStartTime, bullEventTime, false)
        line bullLineId = line.new(bullStartTime, bullEventLevel, bullEventTime, bullEventLevel, xloc=xloc.bar_time, extend=extend.none, color=Bull_Break_Color, style=f_line_style(style), width=width, force_overlay=true)
        label bullLabelId = label.new(bullStartTime, bullEventLevel - syminfo.mintick * 5, tfName + " Break", xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_left, textcolor=Bull_Break_Color, size=size.small, textalign=text.align_left, force_overlay=true)
        label protectedLowLabel = na
        line protectedLowLine = na
        if not na(protectedLowPrice) and not na(protectedLowTime)
            protectedLowLabel := label.new(protectedLowTime, protectedLowPrice, tfName + " Protected Low", xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_up, textcolor=Protected_Line_Color, size=size.small, force_overlay=true)
            protectedLowLine := line.new(protectedLowTime, protectedLowPrice, bullEventTime, protectedLowPrice, xloc=xloc.bar_time, extend=extend.none, color=Protected_Line_Color, style=f_line_style(Protected_Line_Style), width=1, force_overlay=true)
            f_remove_aligned_nc(protectedLowPrice, protectedLowTime, bullEventTime, ncLines, ncLabels)
        array.push(breakLines, bullLineId)
        array.push(breakLabels, bullLabelId)
        array.push(protectedLabels, protectedLowLabel)
        array.push(protectedLines, protectedLowLine)
        array.push(breakDirections, 1)
        array.push(breakLevels, bullEventLevel)
        array.push(breakTimes, bullStartTime)
        array.push(breakRanks, tfSeconds)
        if array.size(breakLines) > maxVisibleBreaks
            line.delete(array.shift(breakLines))
            label.delete(array.shift(breakLabels))
            label oldProtectedLabel = array.shift(protectedLabels)
            if not na(oldProtectedLabel)
                label.delete(oldProtectedLabel)
            line oldProtectedLine = array.shift(protectedLines)
            if not na(oldProtectedLine)
                line.delete(oldProtectedLine)
            array.shift(breakDirections)
            array.shift(breakLevels)
            array.shift(breakTimes)
            array.shift(breakRanks)
    if canDraw and not Hide_Breaks and bearBreak and not duplicateBear
        [protectedHighPrice, protectedHighTime] = f_range_extreme(bearStartTime, bearEventTime, true)
        line bearLineId = line.new(bearStartTime, bearEventLevel, bearEventTime, bearEventLevel, xloc=xloc.bar_time, extend=extend.none, color=Bear_Break_Color, style=f_line_style(style), width=width, force_overlay=true)
        label bearLabelId = label.new(bearStartTime, bearEventLevel - syminfo.mintick * 5, tfName + " Break", xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_left, textcolor=Bear_Break_Color, size=size.small, textalign=text.align_left, force_overlay=true)
        label protectedHighLabel = na
        line protectedHighLine = na
        if not na(protectedHighPrice) and not na(protectedHighTime)
            protectedHighLabel := label.new(protectedHighTime, protectedHighPrice, tfName + " Protected High", xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_down, textcolor=Protected_Line_Color, size=size.small, force_overlay=true)
            protectedHighLine := line.new(protectedHighTime, protectedHighPrice, bearEventTime, protectedHighPrice, xloc=xloc.bar_time, extend=extend.none, color=Protected_Line_Color, style=f_line_style(Protected_Line_Style), width=1, force_overlay=true)
            f_remove_aligned_nc(protectedHighPrice, protectedHighTime, bearEventTime, ncLines, ncLabels)
        array.push(breakLines, bearLineId)
        array.push(breakLabels, bearLabelId)
        array.push(protectedLabels, protectedHighLabel)
        array.push(protectedLines, protectedHighLine)
        array.push(breakDirections, -1)
        array.push(breakLevels, bearEventLevel)
        array.push(breakTimes, bearStartTime)
        array.push(breakRanks, tfSeconds)
        if array.size(breakLines) > maxVisibleBreaks
            line.delete(array.shift(breakLines))
            label.delete(array.shift(breakLabels))
            label oldProtectedLabel = array.shift(protectedLabels)
            if not na(oldProtectedLabel)
                label.delete(oldProtectedLabel)
            line oldProtectedLine = array.shift(protectedLines)
            if not na(oldProtectedLine)
                line.delete(oldProtectedLine)
            array.shift(breakDirections)
            array.shift(breakLevels)
            array.shift(breakTimes)
            array.shift(breakRanks)
    bool ncMatchesProtected = f_is_protected_level(bullEventLevel, bullStartTime, bullEventTime, protectedLines)
    if canDraw and not Hide_Breaks and ncSweep and maxVisibleNCS > 0 and not ncMatchesProtected
        color ncColor = color.rgb(156, 156, 156)
        line ncLineId = line.new(bullStartTime, bullEventLevel, bullEventTime, bullEventLevel, xloc=xloc.bar_time, extend=extend.none, color=ncColor, style=f_line_style(style), width=width, force_overlay=true)
        label ncLabelId = label.new(bullStartTime, bullEventLevel - syminfo.mintick * 5, tfName + " NC + S", xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_left, textcolor=ncColor, size=size.small, textalign=text.align_left, force_overlay=true)
        array.push(ncLines, ncLineId)
        array.push(ncLabels, ncLabelId)
        if array.size(ncLines) > maxVisibleNCS
            line.delete(array.shift(ncLines))
            label.delete(array.shift(ncLabels))

